{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pop-choice-app",
  "main": "./src/worker/index.ts",
  "compatibility_date": "2026-10-15",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist/client",
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "APP_ENV": "development",
    "CORS_ORIGIN": "http://localhost:5273",
    "BETTER_AUTH_URL": "http://localhost:8787"
  },
  "env": {
    "production": {
      "vars": {
        "APP_ENV": "production",
        // Replace <your-subdomain> with your account's workers.dev subdomain.
        "CORS_ORIGIN": "https://pop-choice-app-production.suhail142176.workers.dev",
        "BETTER_AUTH_URL": "https://pop-choice-app-production.suhail142176.workers.dev"
      },
      // `ratelimits` is NOT inherited from the top-level config, so every
      // environment must declare it. A distinct namespace_id keeps local dev
      // and production from sharing rate-limit counters.
      "ratelimits": [
        {
          "name": "RECOMMENDATION_RATE_LIMITER",
          "namespace_id": "1002",
          "simple": {
            "limit": 10,
            "period": 60
          }
        }
      ]
    }
  },
  "ratelimits": [
    {
      "name": "RECOMMENDATION_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ]
}
